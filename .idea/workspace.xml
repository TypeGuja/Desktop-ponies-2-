ove |msg| {&#10;                    let body = msg.body();&#10;                    if let Some(name) = body.strip_prefix(&quot;spawn:&quot;) {&#10;                        spawn_q.lock().unwrap().push(name.to_string());&#10;                    }&#10;                })&#10;                .build(&amp;*ui_window)&#10;                .unwrap();&#10;&#10;            // Сохраняем и окно и webview чтобы они не дропнулись&#10;            self.ui_window = Some(ui_window);&#10;            self.webview = Some(webview);&#10;&#10;            println!(&quot;UI ready. Select a pony and click Spawn.&quot;);&#10;        }&#10;    }&#10;&#10;    fn window_event(&#10;        &amp;mut self,&#10;        event_loop: &amp;winit::event_loop::ActiveEventLoop,&#10;        window_id: WindowId,&#10;        event: WindowEvent,&#10;    ) {&#10;        match event {&#10;            WindowEvent::CloseRequested =&gt; {&#10;                if Some(window_id) == self.ui_window_id {&#10;                    println!(&quot;UI window closed, exiting...&quot;);&#10;                    event_loop.exit();&#10;                }&#10;            }&#10;            WindowEvent::RedrawRequested =&gt; {&#10;                // Окно пони — создаём при первом спавне&#10;                let names: Vec&lt;String&gt; = self.spawn_queue.lock().unwrap().drain(..).collect();&#10;&#10;                if !names.is_empty() {&#10;                    if self.pony_window.is_none() {&#10;                        // Создаём окно пони&#10;                        let mut pw = PonyWindow::new();&#10;                        pw.create_window(event_loop);&#10;                        if let Some(w) = &amp;pw.window {&#10;                            w.set_visible(true);&#10;                        }&#10;                        self.pony_window = Some(Arc::new(Mutex::new(pw)));&#10;                        println!(&quot;Pony window created!&quot;);&#10;                    }&#10;&#10;                    if let Some(pw) = &amp;self.pony_window {&#10;                        if let Ok(mut pw) = pw.lock() {&#10;                            for name in names {&#10;                                pw.spawn_pony(&amp;name);&#10;                            }&#10;                        }&#10;                    }&#10;                }&#10;&#10;                // Рендерим если окно есть&#10;                if let Some(pw) = &amp;self.pony_window {&#10;                    if let Ok(mut pw) = pw.lock() {&#10;                        pw.update_and_render();&#10;                        if let Some(w) = &amp;pw.window {&#10;                            w.request_redraw();&#10;                        }&#10;                    }&#10;                }&#10;            }&#10;            _ =&gt; {}&#10;        }&#10;    }&#10;}" />
