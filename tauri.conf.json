{
  "productName": "Desktop Ponies",
  "version": "0.1.0",
  "identifier": "com.desktop-ponies.rs",
  "build": {
    "frontendDist": "src-ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Desktop Ponies",
        "width": 420,
        "height": 720,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "./icon.ico"
    ]
  }
}